@model IEnumerable<Chi_Day03.Models.Product>
@{
    var categories = ViewBag.Categories as List<Chi_Day03.Models.Category>;
    int? selectedCategoryId = Context.Request.Query["categoryId"].Count > 0
        ? int.Parse(Context.Request.Query["categoryId"])
        : (int?)null;
}

<div class="row mt-4">
    <!-- Danh mục -->
    <div class="col-md-3">
        <h4>DANH MỤC</h4>
        <ul class="list-group">
            @foreach (var c in categories)
            {
                <li class="list-group-item @(selectedCategoryId == c.Id ? "active" : "")">
                    <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@c.Id" class="text-decoration-none text-dark">
                        @c.Name
                    </a>
                </li>
            }
        </ul>
    </div>

    <!-- Danh sách sản phẩm -->
    <div class="col-md-9">
        <h4>Danh sách sản phẩm</h4>
        <div class="row">
            @foreach (var p in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <img src="~/picture/@p.Image" class="card-img-top" alt="@p.Name">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-truncate">@p.Name</h5>
                            <p class="card-text" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                                @p.Description
                            </p>

                            <p class="mt-auto">
                                <span class="text-muted"><s>Giá: @p.Price.ToString("N0") đ</s></span><br />
                                <span class="text-danger">Giá: @p.SalePrice.ToString("N0") đ</span>
                            </p>
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@p.Id" class="btn btn-success mt-2">Chi tiết</a>

                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

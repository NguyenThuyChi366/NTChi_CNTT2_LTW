<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ViewComponents</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ViewComponents.styles.css" asp-append-version="true" />
</head>
<body>
    <partial name="HeaderPartialView" />

    <partial name="BannerPartialView" />

    <div class="container">
        <main role="main" class="pb-3 row">
            <div class="col-md-3">
                @await Component.InvokeAsync("Category")
            </div>
            <div  class="col-md-9">
                @RenderBody()
            </div>
            
        </main>
    </div>

    <partial name="FooterPartialView" />


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

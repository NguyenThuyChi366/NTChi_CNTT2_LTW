@model IEnumerable<NTChi_Day02.Models.Product>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<h2>Quản lý sản phẩm</h2>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Price</th>
            <th>Created At</th>
            <th>Image</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.Name</td>
                <td>@p.Price.ToString("N0") đ</td>
                <td>@p.CreatedAt.ToString("dd-MM-yyyy")</td>
                <td>
                    <img src="~/picture/@p.Image" alt="@p.Name" width="80" />
                </td>
                <td>
                    <a class="btn btn-success" asp-controller="Product" asp-action="Details" asp-route-id="@p.Id">View</a>
                </td>
            </tr>
        }
    </tbody>
</table>

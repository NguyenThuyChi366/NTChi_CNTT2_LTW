@model List<NTChi_Test.Models.Product>

<h1>Danh sách sản phẩm</h1>
<a asp-controller="Product"
   asp-action="Create">
    Thêm sản phẩm
</a>

<table border="1" cellpadding="10">
    <thead>
        <tr>
            <th>ID</th>
            <th>Tên sản phẩm</th>
            <th>Giá</th>
            <th>Loại</th>
            <th>Số lượng</th>
            <th>Mô tả</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Id</td>
                <td>@product.Name</td>
                <td>@product.Price</td>
                <td>@product.Category</td>
                <td>@product.Quantity</td>
                <td>@product.Description</td>
            </tr>
        }
    </tbody>
</table>